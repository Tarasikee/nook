{
    "name": "@nook/ui-react",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "description": "Opinionated React components in Nook's design language, built on @nook/react and @nook/ui.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "babel src --out-dir dist --extensions .ts,.tsx --delete-dir-on-start && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "playwright test"
    },
    "peerDependencies": {
        "react": "^19.2.0"
    },
    "dependencies": {
        "@nook/react": "workspace:*",
        "@nook/ui": "workspace:*"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.0",
        "@babel/core": "^7.28.0",
        "@babel/preset-react": "^7.27.0",
        "@babel/preset-typescript": "^7.27.0",
        "@playwright/test": "1.58.2",
        "@types/node": "^22.20.4",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "babel-plugin-react-compiler": "1.0.0",
        "esbuild": "^0.25.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "^5.7.3"
    }
}
