{
    "name": "@nook/ui-react",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "description": "Opinionated React components in Nook's design language, built on @nook/react and @nook/ui.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "babel src --out-dir dist --extensions .ts,.tsx --delete-dir-on-start && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "playwright test"
    },
    "peerDependencies": {
        "react": "^19.2.0"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.29.7"
    }
}
