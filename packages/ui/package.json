{
    "name": "@nook/ui",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "description": "Native React components and their editable source registry.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./hooks": {
            "types": "./dist/hooks.d.ts",
            "import": "./dist/hooks.js"
        }
    },
    "scripts": {
        "build": "babel src --out-dir dist --extensions .ts,.tsx --delete-dir-on-start && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "playwright test"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.29.7"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0"
    }
}
