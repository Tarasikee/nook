{
    "name": "@nook/ui",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "description": "Nook's design language as plain CSS, authored in vanilla-extract: tokens, button, tooltip, and popover styles for any framework.",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/nook.css.d.ts",
            "import": "./dist/nook.js"
        },
        "./*.css": "./dist/*.css"
    },
    "scripts": {
        "build": "node build.ts && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@vanilla-extract/esbuild-plugin": "^2.3.22"
    }
}
