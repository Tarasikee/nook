{
    "name": "nook",
    "private": true,
    "version": "0.0.0",
    "license": "MIT",
    "description": "Native browser components distributed as editable source through the shadcn CLI.",
    "type": "module",
    "scripts": {
        "build": "pnpm build:components && pnpm build:registry && pnpm --filter @nook/website build",
        "dev": "pnpm --filter @nook/website dev",
        "preview": "pnpm --filter @nook/website preview",
        "check": "prettier --check . && pnpm check:workspace-deps && pnpm lint && pnpm -r typecheck && pnpm check:compiler",
        "check:workspace-deps": "pnpm --filter @nook/cli check:workspace-deps",
        "test": "pnpm build && pnpm test:registry && pnpm --filter @nook/ui test && pnpm --filter @nook/website test",
        "clean": "rm -rf dist packages/*/dist packages/*/test-results packages/*/node_modules/.cache website/test-results website/.vitepress/cache website/.vitepress/dist bench/results",
        "lint": "eslint --max-warnings 0 .",
        "format": "prettier --write .",
        "bench": "pnpm build:components && node bench/check-compiled.mjs && node bench/run.mjs",
        "build:components": "pnpm --filter @nook/ui build",
        "build:registry": "pnpm --filter @nook/cli build",
        "test:registry": "pnpm --filter @nook/cli test",
        "check:compiler": "pnpm --filter @nook/cli check:compiler"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@playwright/test": "1.63.0",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vanilla-extract/css": "^1.21.2",
        "babel-plugin-react-compiler": "1.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "@nook/ui": "workspace:*",
        "@nook/cli": "workspace:*",
        "tailwindcss": "^4.3.5",
        "@tailwindcss/node": "^4.3.5",
        "@tailwindcss/oxide": "^4.3.5"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm"
        }
    }
}
