{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "paths": {
            "@nook/core": ["packages/core/src/index.ts"],
            "@nook/react": ["packages/react/src/index.ts"]
        }
    },
    "include": [
        ".vitepress/**/*.ts",
        ".vitepress/**/*.tsx",
        ".vitepress/**/*.vue",
        "tests/**/*.ts",
        "playwright.config.ts"
    ]
}
