{
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "none",
    "overrides": [
        {
            "files": "*.md",
            "options": { "tabWidth": 2, "embeddedLanguageFormatting": "off" }
        },
        {
            "files": ["*.yaml", "*.yml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
